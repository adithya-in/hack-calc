@@ -126,6 +141,11 @@
         colstart = 0;
         rowstart = 35;
       }
+      else if(_init_width == 76) // 2.25" 76x284 ST7789P3 bar display
+      {
+        colstart = 18;
+        rowstart = 82;
+      }
